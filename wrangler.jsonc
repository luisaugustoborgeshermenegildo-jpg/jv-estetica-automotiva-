// Cloudflare Worker da JV Estética: site estático (dist/) + API em /api/*.
// Secrets (nunca aqui): `npx wrangler secret put ADMIN_PASSWORD`.
// No PC, os secrets locais ficam em .dev.vars (fora do git).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jv-estetica",
  "main": "worker/index.mjs",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "build": { "command": "node build.mjs" },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/health"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "jv-db",
      // Trocar pelo id real depois de `npx wrangler d1 create jv-db`.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    { "name": "LIMIT_BOOKING", "namespace_id": "1001", "simple": { "limit": 6, "period": 60 } },
    { "name": "LIMIT_ADMIN", "namespace_id": "1002", "simple": { "limit": 8, "period": 60 } },
    { "name": "LIMIT_OS", "namespace_id": "1003", "simple": { "limit": 60, "period": 60 } }
  ],
  "observability": { "enabled": true }
}
