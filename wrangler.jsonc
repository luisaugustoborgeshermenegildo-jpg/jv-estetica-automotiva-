// Cloudflare Worker da JV Estética: site estático (dist/) + API em /api/*.
// Secrets (nunca aqui): `npx wrangler secret put ADMIN_PASSWORD`.
// No PC, os secrets locais ficam em .dev.vars (fora do git).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jv-estetica",
  "main": "worker/index.mjs",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "build": { "command": "node build.mjs" },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/health"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "jv-db",
      "database_id": "7e1de623-830c-4c2e-abbe-a7b380d5d70d",
      "migrations_dir": "migrations"
    }
  ],
  // Fotos da vistoria e da entrega (privadas: só saem pela API).
  // Desligado até o R2 ser ativado na conta: depois rodar
  // `npx wrangler r2 bucket create jv-fotos` e tirar o comentário da linha abaixo.
  // "r2_buckets": [{ "binding": "PHOTOS", "bucket_name": "jv-fotos" }],
  "ratelimits": [
    { "name": "LIMIT_BOOKING", "namespace_id": "1001", "simple": { "limit": 6, "period": 60 } },
    { "name": "LIMIT_ADMIN", "namespace_id": "1002", "simple": { "limit": 8, "period": 60 } },
    { "name": "LIMIT_OS", "namespace_id": "1003", "simple": { "limit": 60, "period": 60 } }
  ],
  "observability": { "enabled": true }
}
